# Backend-only staff credential. Replace this placeholder in your ignored local .env.
# Keep this backend credential unprefixed and out of frontend configuration.
STAFF_PIN=replace-with-a-unique-6-digit-pin

# Optional public Supabase client configuration. Do not put service-role keys here.
# Create a project at https://supabase.com
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-public-key
