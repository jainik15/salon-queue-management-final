# Node API runtime. Configure actual secret values in the Render dashboard or ignored .env.
PORT=3001
NODE_ENV=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key
STAFF_PIN=replace-with-a-unique-private-6-digit-pin
STAFF_SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_SAMPLE_DATA_RESET=false

# Vite frontend. In Vercel set this to the public HTTPS URL of the Render API.
VITE_API_BASE_URL=http://localhost:3001
